<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fire_inspection_orchestrator</name>
  <version>0.1.0</version>
  <description>消防巡检编排层：唯一指挥者 / 唯一状态机，按点位顺序调用 navigate_to / inspect_poi / speak 三个 Action。</description>
  <maintainer email="nvidia@example.com">nvidia</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>ros2_bridge_msgs</exec_depend>
  <exec_depend>fire_inspection_interfaces</exec_depend>
  <exec_depend>fire_inspection_nav</exec_depend>
  <exec_depend>fire_inspection_voice</exec_depend>
  <exec_depend>fire_inspection_vision</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
