# ROS 2 / colcon 构建产物
build/
install/
log/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# 模型权重：不入库，机器人上手工放到 models/（见 README）
models/*.pt
models/*.onnx
models/*.engine
models/*.pth

# 编辑器与系统文件
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*~

# 临时日志与打包产物
*.log
*.zip

# 敏感凭证：钉钉机器人 webhook token + 加签密钥
dingtalk.env

# 运行时数据：断网时积压的钉钉待发消息
fire_inspection_ws/dingtalk_queue/

# 运行时数据：抓拍图（与本地 7 天自动清理一致）
fire_inspection_ws/picture/

# 运行时数据：桥接 outbox、音频片段缓存
fire_inspection_ws/data/bridge/outbox.json
audio_cache/

# 备份文件：*.bak 是之前调试时手动存的
*.bak
backups/

# 调试脚本（可按需保留，默认忽略）
test_dingtalk.py
